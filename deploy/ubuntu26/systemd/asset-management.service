[Unit]
Description=Asset Registration Management System Backend
After=network.target

[Service]
Type=simple
User=assetmgmt
Group=assetmgmt
WorkingDirectory=/opt/asset-management
EnvironmentFile=/opt/asset-management/.env
ExecStart=/opt/asset-management/backend/asset-management-server
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/asset-management/data /opt/asset-management/backups

[Install]
WantedBy=multi-user.target
