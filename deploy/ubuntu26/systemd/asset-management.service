[Unit]
Description=Asset Registration Management System Backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=assetmgmt
Group=assetmgmt
WorkingDirectory=/opt/asset-management
EnvironmentFile=/opt/asset-management/.env
ExecStart=/opt/asset-management/backend/asset-management-server
Restart=always
RestartSec=3
TimeoutStopSec=30
KillSignal=SIGTERM
LimitNOFILE=65536
MemoryMax=1G
TasksMax=256
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/opt/asset-management/data /opt/asset-management/backups /opt/asset-management/logs

[Install]
WantedBy=multi-user.target
